# 复制成 .env 并填好，权限设 600，不要提交到 git。
# 消费方：plugins/play_music_library.py（取音频）与 connection.py 里注入的
# _load_music_resolver()（搜索/随机取曲）。两者都用 Subsonic token 鉴权，
# 口令本身不会出现在 URL 或日志里。

# ---- 必填 ----
# 音乐库的 Subsonic 接口地址（Navidrome 默认 4533 端口）。
# 从 xiaozhi-esp32-server 容器内能访问到即可：同宿主机直连填 127.0.0.1，
# 跨容器共享网络则填那台服务的名字。
NAVIDROME_URL=http://127.0.0.1:4533
# 专用 API 用户（用 nd_create_api_user.sh 建的那个，**不要用管理员**）
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# ---- 选填（不填用插件里的默认值）----
# 音频落点。必须与 xiaozhi 配置里的 output_dir 一致，且**保持相对路径**，
# 否则播完不会自动清理（见 docker-compose.additions.yml 的说明）。
# XIAOZHI_TMP_DIR=tmp
# 取音频的格式：raw = 原样返回原始文件（推荐，不转码、不占音乐库 CPU）；
# 改成 mp3 会让音乐库转码成小文件，适合音乐库不在本机/带宽紧张的场景。
# NAVIDROME_STREAM_FORMAT=raw
# 单曲字节上限，超过就跳过该曲并记日志（默认 320MB）
# NAVIDROME_MAX_BYTES=335544320
