# 复制成 .env 并填好，权限设 600，不要提交到 git。
# 两个消费方：plugins/bookorbit_audiobook.py（取路径/进度）与 connection.py
# 里注入的 _load_audiobook_titles()（取书名清单）。

# ---- 必填 ----
# BookOrbit 的 Postgres 地址。从 xiaozhi-esp32-server 容器内能连到即可：
# 同宿主机直连填 127.0.0.1，跨容器共享网络则填那台服务的名字。
BOOKORBIT_PG_HOST=
BOOKORBIT_PG_DB=bookorbit
BOOKORBIT_PG_USER=bookorbit
BOOKORBIT_PG_PASSWORD=

# ---- 选填（不填用插件里的默认值）----
# compose 用：宿主机上书库的根目录，会挂在 /books:ro
# BOOKORBIT_BOOKS_DIR=/path/to/bookorbit/books
# 有声书那一库的 library_id（BookOrbit 里建库时的自增 id）
# BOOKORBIT_LIBRARY_ID=4
# 容器内挂载点，需与数据库里 book_files.absolute_path 的前缀一致
# BOOKORBIT_BOOKS_ROOT=/books
# 取不到数据库时的退化扫描目录
# BOOKORBIT_TITLES_FALLBACK_DIR=/books
# 进度表里你的用户 id（单用户形态通常是 1）
# BOOKORBIT_USER_ID=1
